# --- Twilio (leave blank to run in dev mode with the browser simulator) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The clinic number patients text (E.164). In dev mode this is a fake 555 number.
CLINIC_NUMBER=+17405550100
# Public https address Twilio posts to, used to check Twilio's signature, e.g. https://srv1619809.hstgr.cloud/textbridge
PUBLIC_BASE_URL=

# On-call community health worker phones, comma-separated (E.164).
# Fictional 555-01xx numbers never go to Twilio: they stay on the simulator's worker phone,
# so one real phone can test the patient side (set DEV_SIMULATOR=1 too).
CHW_NUMBERS=+17405550199

# --- athenahealth scheduling (blank = mock clinic calendar) ---
# Get Preview keys at https://developer.athenahealth.com (create an app, 2-legged / client credentials).
ATHENA_CLIENT_ID=
ATHENA_CLIENT_SECRET=
# One practice id per clinic organization, comma-separated. 195900 = the shared Preview sandbox.
ATHENA_PRACTICE_IDS=195900
# Older name for a single practice; used only when ATHENA_PRACTICE_IDS is blank.
ATHENA_PRACTICE_ID=
# preview | production
ATHENA_ENV=preview
# Point at a stand-in instead of athenahealth, e.g. http://127.0.0.1:8796 for tools/fake_athena.py.
ATHENA_BASE_URL=
# Seconds before one athenahealth request is given up (default 20).
ATHENA_TIMEOUT=
# Extra tries after a 429 or 5xx answer (default 3).
ATHENA_RETRIES=
# First wait between tries in seconds, doubled each time; Retry-After wins when sent (default 0.5).
ATHENA_BACKOFF=

# --- Clinic finder ---
# Where clinics come from: sample (app/data/services.json, default) or athena (the departments
# of ATHENA_PRACTICE_IDS plus the overrides file).
CLINIC_SOURCE=sample
# Overrides file: short name, income group, needs, appointment types (default app/data/clinic_overrides.json).
CLINIC_OVERRIDES=
# Seconds between reloads of the clinic directory from athenahealth (default 3600).
CLINIC_DIRECTORY_TTL=
# Timezone for a department that names none (default America/New_York).
CLINIC_TIMEZONE=
# Clinics farther than this from the patient are never offered (default 45).
MAX_CLINIC_MILES=
# How many of the nearest clinics have their open times fetched (default 6).
CANDIDATES_TO_CHECK=
# A clinic tagged for the patient's need counts as this many miles closer (default 15).
NEED_TAG_BONUS_MILES=
# Seconds to wait for one clinic's open times before leaving it out (default 5).
ATHENA_SLOT_TIMEOUT=

# --- Claude triage (blank = keyword triage) ---
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-haiku-5-5
# With a key, booking answers in the patient's own words ("im on medicaid", "the tuesday one")
# are understood too. Set FREE_TEXT=0 to accept only exact answers (1, 2, a ZIP).
FREE_TEXT=
UNDERSTAND_MODEL=claude-haiku-5-5

# --- Dashboard login (blank = no login, local dev only) ---
DASHBOARD_PASSWORD=

DB_PATH=textbridge.db
# Force the /dev simulator on even with Twilio keys set (never in production)
DEV_SIMULATOR=
